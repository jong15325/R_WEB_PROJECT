@{
    var alertMessage = TempData["AlertMessage"] as string;
}

@if (alertMessage != null)
{
    <script>
        /*
            [Description("Basic")]
            Basic,

            [Description("Confirm")]
            Confirm,

            [Description("Timer")]
            Timer,

            [Description("Mixin")]
            Mixin,
        */

        var alert = JSON.parse('@Html.Raw(alertMessage)');
        console.log(alert);
        switch (alert.AlertType) {
            case 'BASIC': 
                {
                    Swal.fire({
                        title: alert.Title,
                        text: alert.Message,
                        icon: alert.AlertIconType.toLowerCase()
                    });
                    break;
                }
            case 'CONFIRM':
                {
                    Swal.fire({
                        title: alert.Title,
                        text: alert.Message,
                        icon: alert.AlertIconType.toLowerCase()
                    });
                    break;
                }
            case 'TIMER':
                {
                    Swal.fire({
                        title: alert.Title,
                        text: alert.Message,
                        icon: alert.AlertIconType.toLowerCase()
                    });
                    break;
                }
            case 'MIXIN':
                {
                    const Toast = Swal.mixin({
                        toast: true,
                        position: "top-end",
                        showConfirmButton: false,
                        timer: 2000,
                        timerProgressBar: true,
                        didOpen: (toast) => {
                            toast.onmouseenter = Swal.stopTimer;
                            toast.onmouseleave = Swal.resumeTimer;
                            toast.style.fontSize = "13px"; // 텍스트 크기 조절
                        }
                    });
                    Toast.fire({
                        icon: alert.AlertIconType.toLowerCase(),
                        title: alert.Title,
                    });
                    break;
                }
            default:
                {
                    Swal.fire({
                        title: alert.Title,
                        text: alert.Message,
                        icon: alert.AlertIconType.toLowerCase()
                    });
                    break;
                }
        }
    </script>
}